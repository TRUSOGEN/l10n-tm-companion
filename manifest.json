{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "L10n TM Companion",
  "version": "1.5.0",
  "key": "",
  "description": "Feishu source → Starling TM → AI source rewrite → optional ROI archive",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "sidePanel",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.feishu.cn/*",
    "*://*.larksuite.com/*",
    "*://*.larkoffice.com/*",
    "https://open.feishu.cn/*",
    "https://inspire.bytedance.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.feishu.cn/docx/*",
        "*://*.feishu.cn/wiki/*",
        "*://*.feishu.cn/sheets/*",
        "*://*.larksuite.com/docx/*",
        "*://*.larksuite.com/wiki/*",
        "*://*.larksuite.com/sheets/*",
        "*://*.larkoffice.com/docx/*",
        "*://*.larkoffice.com/wiki/*",
        "*://*.larkoffice.com/sheets/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
